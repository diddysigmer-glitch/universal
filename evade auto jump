-- FILTER PROTECTED OBJECTS (PLAYERS, DEPLOYABLES, EMOTES)
local function isProtectedObject(obj)
    local cur = obj
    while cur and cur ~= workspace do
        -- Protect player characters entirely
        if cur:IsA("Model") and (game.Players:GetPlayerFromCharacter(cur) or cur:FindFirstChildOfClass("Humanoid")) then
            if not cur.Name:lower():find("nextbot") and not cur.Name:lower():find("bot") then
                return true
            end
        end

        local name = cur.Name:lower()
        if name:find("placed") or name:find("deploy") or name:find("utility") 
           or name:find("item") or name:find("emote") or name:find("prop") 
           or name:find("structure") or name:find("barricade") or name:find("sensor") then
            return true
        end
        cur = cur.Parent
    end
    return false
end

-- PROCESS A SINGLE MAP PART FOR FPS OPTIMIZER
local function processPartForFPS(obj)
    if isProtectedObject(obj) then return end

    if obj:IsA("Decal") or obj:IsA("Texture") then
        table.insert(removedItems, {
            type = "Texture",
            parent = obj.Parent,
            texture = obj.Texture,
            className = obj.ClassName,
            face = obj:IsA("Decal") and obj.Face or nil,
        })
        obj:Destroy()

    elseif obj:IsA("BasePart") and not obj.CanCollide then
        local name = obj.Name:lower()
        local parentName = obj.Parent and obj.Parent.Name:lower() or ""

        local isBarrier = name:find("door") or name:find("wall") or name:find("frame") 
                       or name:find("glass") or name:find("window") or name:find("arch")
                       or name:find("barrier") or name:find("rail") or name:find("fence")
                       or parentName:find("door") or parentName:find("window")

        local isTriggerZone = name:find("zone") or name:find("trigger") or name:find("spawn")
                           or name:find("area") or name:find("hitbox") or name:find("node")
                           or name:find("part") or name:find("box")

        if isTriggerZone or obj.Transparency > 0.5 then
            table.insert(removedItems, {
                type = "Part",
                instance = obj,
                originalTransparency = obj.Transparency
            })
            obj.Transparency = 1

        elseif isBarrier then
            table.insert(removedItems, {
                type = "Part",
                instance = obj,
                originalTransparency = obj.Transparency
            })
            obj.Transparency = math.clamp(obj.Transparency, 0, 0.3)
        else
            table.insert(removedItems, {
                type = "Part",
                instance = obj,
                originalTransparency = obj.Transparency
            })
            obj.Transparency = 1
        end
    end
end

-- FPS OPTIMIZER TOGGLE
local function toggleTextureRemoval(forceState)
    if forceState ~= nil then
        textureRemovalOn = forceState
    else
        textureRemovalOn = not textureRemovalOn
    end

    if textureRemovalOn then
        removedItems = {}
        for _, obj in ipairs(workspace:GetDescendants()) do
            processPartForFPS(obj)
        end
    else
        for _, data in ipairs(removedItems) do
            if data.type == "Texture" then
                local parent = data.parent
                if parent and parent:IsA("BasePart") then
                    local newObj
                    if data.className == "Decal" then
                        newObj = Instance.new("Decal")
                        if data.face then newObj.Face = data.face end
                    elseif data.className == "Texture" then
                        newObj = Instance.new("Texture")
                    end
                    if newObj then
                        newObj.Texture = data.texture
                        newObj.Parent = parent
                    end
                end
            elseif data.type == "Part" then
                if data.instance and data.instance.Parent then
                    data.instance.Transparency = data.originalTransparency
                end
            end
        end

        removedItems = {}
    end

    if fpsButtonRef then
        fpsButtonRef.BackgroundColor3 = textureRemovalOn and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    end
end

-- LANTERN / PERSISTENT LIGHT LOGIC
local function removePersistentLanternLights()
    for _, lightObj in ipairs(persistentLanternLights) do
        if lightObj and lightObj.Parent then
            lightObj:Destroy()
        end
    end
    persistentLanternLights = {}
end

local function captureAndPersistLanternLight(char)
    if not char or not lanternToggleOn then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    for _, descendant in ipairs(char:GetDescendants()) do
        if descendant:IsA("Light") and descendant.Name ~= "PersistentLanternLight" then
            local clonedLight = descendant:Clone()
            clonedLight.Name = "PersistentLanternLight"
            clonedLight.Parent = root
            table.insert(persistentLanternLights, clonedLight)
        end
    end
end

local function toggleLanternMode(forceState)
    if forceState ~= nil then
        lanternToggleOn = forceState
    else
        lanternToggleOn = not lanternToggleOn
    end

    if lanternButtonRef then
        lanternButtonRef.BackgroundColor3 = lanternToggleOn and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    end

    if spinningFloppaImage then
        spinningFloppaImage.Visible = lanternToggleOn
    end

    if lanternToggleOn then
        if spinConnection then spinConnection:Disconnect() end
        spinConnection = runService.RenderStepped:Connect(function()
            if spinningFloppaImage and spinningFloppaImage.Visible then
                spinningFloppaImage.Rotation = (spinningFloppaImage.Rotation + 3) % 360
            end
        end)

        if player.Character then
            removePersistentLanternLights()
            captureAndPersistLanternLight(player.Character)
        end
    else
        if spinConnection then
            spinConnection:Disconnect()
            spinConnection = nil
        end
        removePersistentLanternLights()
    end
end

-- =========================================================
-- NEXTBOT RED GLOW ENGINE (EXCLUSIVELY FOR NEXTBOTS)
-- =========================================================

local function applyNextbotGlow(model)
    if not model or not model:IsA("Model") then return end
    
    if game.Players:GetPlayerFromCharacter(model) then return end

    local primaryPart = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("RootPart") or model:FindFirstChildWhichIsA("BasePart")
    if not primaryPart then return end

    if not nextbotGlows[model] or not nextbotGlows[model].Parent then
        local redLight = Instance.new("PointLight")
        redLight.Name = "NextbotRedGlow"
        redLight.Color = Color3.fromRGB(255, 0, 0)
        redLight.Brightness = 3.5
        redLight.Range = 25
        redLight.Shadows = false
        redLight.Parent = primaryPart
        nextbotGlows[model] = redLight
    end
end

local function removeAllNextbotGlows()
    for model, light in pairs(nextbotGlows) do
        if light and light.Parent then
            light:Destroy()
        end
    end
    nextbotGlows = {}
end

local function scanAndGlowNextbots()
    if not darkModeOn then return end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and not game.Players:GetPlayerFromCharacter(obj) then
            local isNextbot = obj.Name:lower():find("nextbot") or obj.Name:lower():find("bot")
            if isNextbot then
                applyNextbotGlow(obj)
            end
        end
    end
end

