local function removePersistentLanternLights()
	for _, l in ipairs(persistentLanternLights) do 
		if l and l.Parent then l:Destroy() end 
	end
	persistentLanternLights = {}
end

local function captureAndPersistLanternLight(char)
	if not char or not lanternToggleOn then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local foundLight = nil
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("Light") and d.Name ~= "PersistentLanternLight" then
			foundLight = d
			break
		end
	end

	removePersistentLanternLights()

	local clonedLight
	if foundLight then
		clonedLight = foundLight:Clone()
		clonedLight.Name = "PersistentLanternLight"
		clonedLight.Enabled = true
		clonedLight.Shadows = false 
		clonedLight.Brightness = math.max(clonedLight.Brightness, 4) 
		clonedLight.Range = math.max(clonedLight.Range, 40) 
		clonedLight.Parent = root
	else
		clonedLight = Instance.new("PointLight")
		clonedLight.Name = "PersistentLanternLight"
		clonedLight.Color = Color3.fromRGB(255, 245, 215) 
		clonedLight.Brightness = 4
		clonedLight.Range = 40
		clonedLight.Shadows = false 
		clonedLight.Parent = root
	end

	if clonedLight then
		table.insert(persistentLanternLights, clonedLight)
	end
end

local function toggleLanternMode(forceState)
	lanternToggleOn = forceState ~= nil and forceState or not lanternToggleOn

	if lanternButtonRef then
		lanternButtonRef.BackgroundColor3 = lanternToggleOn and Color3.fromRGB(0, 180, 100) or Color3.fromRGB(50, 50, 55)
	end
	if spinningFloppaImage then spinningFloppaImage.Visible = lanternToggleOn end

	if lanternToggleOn then
		if spinConnection then spinConnection:Disconnect() end
		spinConnection = runService.RenderStepped:Connect(function()
			if spinningFloppaImage and spinningFloppaImage.Visible then
				spinningFloppaImage.Rotation = (spinningFloppaImage.Rotation + 3) % 360
			end
		end)
		if player.Character then 
			captureAndPersistLanternLight(player.Character) 
		end
	else
		if spinConnection then spinConnection:Disconnect(); spinConnection = nil end
		removePersistentLanternLights()
	end
end

