    stars.ImageTransparency = 0.3
    stars.ImageColor3 = Color3.fromRGB(255, 255, 255)
    stars.Parent = gui

    local aurora = Instance.new("ImageLabel")
    aurora.Size = UDim2.new(1, 0, 1, 0)
    aurora.Position = UDim2.new(0, 0, 0, 0)
    aurora.BackgroundTransparency = 1
    aurora.Image = "rbxthumb://type=Asset&id=160662430&w=420&h=420"
    aurora.ImageTransparency = 0.5
    aurora.ImageColor3 = Color3.fromRGB(200, 230, 255)
    aurora.Parent = gui

    local starRot = 0
    local auroraRot = 0
    runService.Heartbeat:Connect(function(dt)
        if darkModeOn then
            starRot = (starRot + dt * 0.2) % 360
            auroraRot = (auroraRot + dt * 0.5) % 360
            stars.Rotation = starRot
            aurora.Rotation = auroraRot
        end
    end)

    overlayGui = gui
    gui.Enabled = false
end

local function showOverlay(show)
    if not overlayGui then createOverlay() end
    overlayGui.Enabled = show
end

local function addLightToCharacter(char)
    if not char or not char:IsA("Model") then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    for plr, light in pairs(darkLights) do
        if light and light.Parent == root then
            light:Destroy()
            darkLights[plr] = nil
        end
    end

    local light = Instance.new("PointLight")
    light.Color = Color3.fromRGB(255, 255, 255)
    light.Brightness = 1.2
    light.Range = 18
    light.Shadows = false
    light.Parent = root
    light.Position = Vector3.new(0, -3, 0)

    for _, plr in ipairs(game.Players:GetPlayers()) do
        if plr.Character == char then
            darkLights[plr] = light
            break
        end
    end
end

local function removeAllLights()
    for _, light in pairs(darkLights) do
        if light then light:Destroy() end
    end
    darkLights = {}
end

local function applyNightTime()
    originalLighting = {
        Brightness = lighting.Brightness,
        Ambient = lighting.Ambient,
        OutdoorAmbient = lighting.OutdoorAmbient,
        ClockTime = lighting.ClockTime,
    }

    lighting.Brightness = 0.4
    lighting.Ambient = Color3.fromRGB(38, 38, 51)
    lighting.OutdoorAmbient = Color3.fromRGB(38, 38, 51)
    lighting.ClockTime = 2

    showOverlay(true)
end

local function restoreLighting()
    lighting.Brightness = originalLighting.Brightness or 1
    lighting.Ambient = originalLighting.Ambient or Color3.fromRGB(128, 128, 128)
    lighting.OutdoorAmbient = originalLighting.OutdoorAmbient or Color3.fromRGB(128, 128, 128)
    lighting.ClockTime = originalLighting.ClockTime or 14
    originalLighting = {}

    showOverlay(false)
end

local function toggleDarkMode()
    darkModeOn = not darkModeOn

    if darkModeOn then
        applyNightTime()
        for _, plr in ipairs(game.Players:GetPlayers()) do
            if plr.Character then addLightToCharacter(plr.Character) end
        end
    else
        restoreLighting()
        removeAllLights()
    end

    if darkButtonRef then
        darkButtonRef.BackgroundColor3 = darkModeOn and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    end
end

local function onPlayerAdded(plr)
    plr.CharacterAdded:Connect(function(char)
        if darkModeOn then addLightToCharacter(char) end
    end)
end

for _, plr in ipairs(game.Players:GetPlayers()) do onPlayerAdded(plr) end
game.Players.PlayerAdded:Connect(onPlayerAdded)

