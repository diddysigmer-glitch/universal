-- Auto-Jump / Tap Jump (Pure Native Evade Jump)
local player = game.Players.LocalPlayer
local userInputService = game:GetService("UserInputService")
local runService = game:GetService("RunService")
local lighting = game:GetService("Lighting")

-- ===== CONFIGURATION =====
local TAP_THRESHOLD = 0.2
local HOLD_DELAY = 0.2
-- =========================

-- ---- Texture removal toggle ----
local textureRemovalOn = false
local removedItems = {}

-- ---- Dark mode toggle ----
local darkModeOn = false
local originalLighting = {}
local darkLights = {}          -- stores lights per player
local overlayGui = nil         -- for stars + aurora
local darkButtonRef = nil      -- reference for immediate update
local fpsButtonRef = nil       -- reference for immediate update

-- ---- Helper: is inside a character? ----
local function isInsideCharacter(inst)
    local parent = inst
    while parent do
        if parent:IsA("Model") and parent:FindFirstChild("Humanoid") then return true end
        parent = parent.Parent
    end
    return false
end

-- ---- Texture removal ----
local function toggleTextureRemoval()
    textureRemovalOn = not textureRemovalOn
    if textureRemovalOn then
        removedItems = {}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if (obj:IsA("Decal") or obj:IsA("Texture")) and not isInsideCharacter(obj) then
                table.insert(removedItems, {
                    parent = obj.Parent,
                    texture = obj.Texture,
                    className = obj.ClassName,
                    face = obj:IsA("Decal") and obj.Face or nil,
                })
                obj:Destroy()
            end
        end
    else
        for _, data in ipairs(removedItems) do
            local parent = data.parent
            if parent and parent:IsA("BasePart") then
                local newObj
                if data.className == "Decal" then
                    newObj = Instance.new("Decal")
                    if data.face then newObj.Face = data.face end
                elseif data.className == "Texture" then
                    newObj = Instance.new("Texture")
                end
                if newObj then
                    newObj.Texture = data.texture
                    newObj.Parent = parent
                end
            end
        end
        removedItems = {}
    end
    -- Update FPS button color immediately
    if fpsButtonRef then
        fpsButtonRef.BackgroundColor3 = textureRemovalOn and Color3.new(0, 1, 0) or Color3.new(1, 0, 0)
    end
end

-- ---- Private Star & Aurora Overlay (only you see it) ----
local function createOverlay()
    if overlayGui then return end

    local gui = Instance.new("ScreenGui")
    gui.Name = "StarAuroraOverlay"
    gui.ResetOnSpawn = false
    gui.Parent = player.PlayerGui

    -- Stars (background)
    local stars = Instance.new("ImageLabel")
    stars.Size = UDim2.new(1, 0, 1, 0)
    stars.Position = UDim2.new(0, 0, 0, 0)
    stars.BackgroundTransparency = 1
    stars.Image = "rbxassetid://213862428"   -- starfield
    stars.ImageTransparency = 0.3
    stars.ImageColor3 = Color3.new(1, 1, 1)
    stars.Parent = gui

    -- Aurora (foreground)
    local aurora = Instance.new("ImageLabel")
    aurora.Size = UDim2.new(1, 0, 1, 0)
    aurora.Position = UDim2.new(0, 0, 0, 0)
    aurora.BackgroundTransparency = 1
    aurora.Image = "rbxassetid://160662430"  -- transparent aurora
    aurora.ImageTransparency = 0.5
    aurora.ImageColor3 = Color3.new(0.8, 0.9, 1)
    aurora.Parent = gui

    -- Gentle rotation
    local starRot = 0
    local auroraRot = 0
    runService.Heartbeat:Connect(function(dt)
        if darkModeOn then
            starRot = (starRot + dt * 0.2) % 360
            auroraRot = (auroraRot + dt * 0.5) % 360
            stars.Rotation = starRot
            aurora.Rotation = auroraRot
        end
    end)

    overlayGui = gui
    gui.Enabled = false
end

local function showOverlay(show)
    if not overlayGui then createOverlay() end
    overlayGui.Enabled = show
end

-- ---- Light under ALL players (visible to everyone) ----
local function addLightToCharacter(char)
    if not char or not char:IsA("Model") then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Remove any existing light for this character
    for player, light in pairs(darkLights) do
        if light and light.Parent == root then
            light:Destroy()
            darkLights[player] = nil
        end
    end

    local light = Instance.new("PointLight")
    light.Color = Color3.new(1, 1, 1)
    light.Brightness = 1.2
    light.Range = 18
    light.Shadows = false
    light.Parent = root
    light.Position = Vector3.new(0, -3, 0)

    -- Store reference by player
    for _, plr in ipairs(game.Players:GetPlayers()) do
        if plr.Character == char then
            darkLights[plr] = light
            break
        end
    end
end

local function removeAllLights()
    for player, light in pairs(darkLights) do
        if light then light:Destroy() end
    end
    darkLights = {}
end

-- ---- Dark mode (less dark now) ----
local function applyNightTime()
    originalLighting = {
        Brightness = lighting.Brightness,
        Ambient = lighting.Ambient,
        OutdoorAmbient = lighting.OutdoorAmbient,
        ClockTime = lighting.ClockTime,
    }

    -- Increased brightness for less dark
    lighting.Brightness = 0.4          -- was 0.3
    lighting.Ambient = Color3.new(0.15, 0.15, 0.2)   -- slightly brighter
    lighting.OutdoorAmbient = Color3.new(0.15, 0.15, 0.2)
    lighting.ClockTime = 2

    showOverlay(true)
end

local function restoreLighting()
    lighting.Brightness = originalLighting.Brightness or 1
    lighting.Ambient = originalLighting.Ambient or Color3.new(0.5, 0.5, 0.5)
    lighting.OutdoorAmbient = originalLighting.OutdoorAmbient or Color3.new(0.5, 0.5, 0.5)
    lighting.ClockTime = originalLighting.ClockTime or 14
    originalLighting = {}

    showOverlay(false)
end

local function toggleDarkMode()
    darkModeOn = not darkModeOn

    if darkModeOn then
        applyNightTime()
        -- Add light to ALL existing characters
        for _, plr in ipairs(game.Players:GetPlayers()) do
            if plr.Character then addLightToCharacter(plr.Character) end
        end
    else
        restoreLighting()
        removeAllLights()
    end

    -- Update Dark button color immediately
    if darkButtonRef then
        darkButtonRef.BackgroundColor3 = darkModeOn and Color3.new(0, 1, 0) or Color3.new(1, 0, 0)
    end
end

-- Handle new players / respawns
local function onPlayerAdded(plr)
    plr.CharacterAdded:Connect(function(char)
        if darkModeOn then addLightToCharacter(char) end
    end)
end
for _, plr in ipairs(game.Players:GetPlayers()) do onPlayerAdded(plr) end
game.Players.PlayerAdded:Connect(onPlayerAdded)

