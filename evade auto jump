local function applyNextbotGlow(model)
	if not model or not model:IsA("Model") or game.Players:GetPlayerFromCharacter(model) then return end
	local part = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("RootPart") or model:FindFirstChildWhichIsA("BasePart")
	if not part then return end
	if not nextbotGlows[model] or not nextbotGlows[model].Parent then
		local r = Instance.new("PointLight")
		r.Name = "NextbotRedGlow"
		r.Color = Color3.fromRGB(255, 0, 0)
		r.Brightness = 3.5
		r.Range = 25
		r.Shadows = false
		r.Parent = part
		nextbotGlows[model] = r
	end
end

local function removeAllNextbotGlows()
	for _, l in pairs(nextbotGlows) do if l and l.Parent then l:Destroy() end end
	nextbotGlows = {}
end

local function scanAndGlowNextbots()
	if not darkModeOn then return end
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and not game.Players:GetPlayerFromCharacter(obj) then
			if obj.Name:lower():find("nextbot") or obj.Name:lower():find("bot") then applyNextbotGlow(obj) end
		end
	end
end

