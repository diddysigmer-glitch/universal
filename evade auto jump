-- =========================================================
-- ROUND TIMER
-- =========================================================

local function formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function updateRoundTimerDisplay()
	if not roundTimerLabel then return end
	if not isRoundActive then
		roundTimerLabel.Text = "⏱  Waiting for round..."
		roundTimerLabel.TextColor3 = Color3.fromRGB(140, 140, 145)
		return
	end
	if roundStartTime then
		local remaining = math.max(0, roundDuration - (tick() - roundStartTime))
		roundTimerLabel.Text = "⏱  " .. formatTime(remaining)
		if remaining <= 30 then
			roundTimerLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
		elseif remaining <= 60 then
			roundTimerLabel.TextColor3 = Color3.fromRGB(255, 200, 80)
		else
			roundTimerLabel.TextColor3 = Color3.fromRGB(0, 220, 120)
		end
		if remaining <= 0 then
			roundTimerLabel.Text = "⏱  Round Over!"
			isRoundActive = false
		end
	end
end

local function detectRoundFromGameState()
	local function findEvadeTimer()
		for _, gui in ipairs(playerGui:GetChildren()) do
			if gui:IsA("ScreenGui") and gui.Name ~= "AutoJumpNotification" and gui.Name ~= "LoadingScreen" then
				for _, desc in ipairs(gui:GetDescendants()) do
					if desc:IsA("TextLabel") then
						local mins, secs = desc.Text:match("^(%d+):(%d%d)$")
						if mins and secs then
							local total = tonumber(mins) * 60 + tonumber(secs)
							if total > 0 and total <= 300 then return total, desc end
						end
					end
				end
			end
		end
		return nil, nil
	end

	local function hasActiveNextbots()
		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("Model") and not game.Players:GetPlayerFromCharacter(obj) then
				local n = obj.Name:lower()
				if (n:find("nextbot") or n:find("bot")) and obj:FindFirstChildWhichIsA("BasePart") then
					return true
				end
			end
		end
		return false
	end

	local function checkReplicatedValues()
		for _, folder in ipairs({replicatedStorage:FindFirstChild("Round"), replicatedStorage:FindFirstChild("GameData"), replicatedStorage}) do
			if folder then
				for _, child in ipairs(folder:GetChildren()) do
					if (child:IsA("IntValue") or child:IsA("NumberValue")) then
						if child.Name:lower():find("time") or child.Name:lower():find("timer") then
							if child.Value > 0 and child.Value <= 300 then return child.Value end
						end
					end
				end
			end
		end
		return nil
	end

	return findEvadeTimer, hasActiveNextbots, checkReplicatedValues
end

local findEvadeTimer, hasActiveNextbots, checkReplicatedValues

local function startRoundTimerTracking()
	findEvadeTimer, hasActiveNextbots, checkReplicatedValues = detectRoundFromGameState()
	if roundTimerConnection then roundTimerConnection:Disconnect() end

	local syncedFromEvade = false

	roundTimerConnection = runService.Heartbeat:Connect(function()
		local evadeTime = findEvadeTimer()
		if evadeTime and evadeTime > 0 then
			syncedFromEvade = true
			isRoundActive = true
			if roundTimerLabel then
				roundTimerLabel.Text = "⏱  " .. formatTime(evadeTime)
				roundTimerLabel.TextColor3 = evadeTime <= 30 and Color3.fromRGB(255, 80, 80) or evadeTime <= 60 and Color3.fromRGB(255, 200, 80) or Color3.fromRGB(0, 220, 120)
			end
			return
		end

		local repTime = checkReplicatedValues()
		if repTime and repTime > 0 then
			isRoundActive = true
			syncedFromEvade = false
			if roundTimerLabel then
				roundTimerLabel.Text = "⏱  " .. formatTime(repTime)
				roundTimerLabel.TextColor3 = repTime <= 30 and Color3.fromRGB(255, 80, 80) or repTime <= 60 and Color3.fromRGB(255, 200, 80) or Color3.fromRGB(0, 220, 120)
			end
			return
		end

		local botsExist = hasActiveNextbots()
		if botsExist and not isRoundActive then
			isRoundActive = true
			roundStartTime = tick()
			roundDuration = ROUND_DURATION
			syncedFromEvade = false
		elseif not botsExist and isRoundActive and not syncedFromEvade then
			isRoundActive = false
			roundStartTime = nil
			if roundTimerLabel then
				roundTimerLabel.Text = "⏱  Waiting for round..."
				roundTimerLabel.TextColor3 = Color3.fromRGB(140, 140, 145)
			end
		end

		if isRoundActive and not syncedFromEvade then
			updateRoundTimerDisplay()
		end
	end)

	table.insert(connections, roundTimerConnection)
end

-- =========================================================
-- PROTECTED OBJECT FILTER
-- =========================================================

local function isProtectedObject(obj)
	local cur = obj
	while cur and cur ~= workspace do
		if cur:IsA("Model") and (game.Players:GetPlayerFromCharacter(cur) or cur:FindFirstChildOfClass("Humanoid")) then
			if not cur.Name:lower():find("nextbot") and not cur.Name:lower():find("bot") then return true end
		end
		local name = cur.Name:lower()
		if name:find("placed") or name:find("deploy") or name:find("utility")
			or name:find("item") or name:find("emote") or name:find("prop")
			or name:find("structure") or name:find("barricade") or name:find("sensor") then
			return true
		end
		cur = cur.Parent
	end
	return false
end

-- =========================================================
-- FPS OPTIMIZER
-- =========================================================

local function processPartForFPS(obj)
	if isProtectedObject(obj) then return end

	if obj:IsA("Decal") or obj:IsA("Texture") then
		table.insert(removedItems, { type = "Texture", parent = obj.Parent, texture = obj.Texture, className = obj.ClassName, face = obj:IsA("Decal") and obj.Face or nil })
		obj:Destroy()
	elseif obj:IsA("ParticleEmitter") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
		table.insert(removedItems, { type = "Effect", instance = obj, wasEnabled = obj:IsA("ParticleEmitter") and obj.Enabled or true })
		if obj:IsA("ParticleEmitter") then obj.Enabled = false else obj.Parent = nil end
	elseif obj:IsA("BasePart") and not obj.CanCollide then
		local name = obj.Name:lower()
		local parentName = obj.Parent and obj.Parent.Name:lower() or ""
		local isBarrier = name:find("door") or name:find("wall") or name:find("frame") or name:find("glass") or name:find("window") or name:find("arch") or name:find("barrier") or name:find("rail") or name:find("fence") or parentName:find("door") or parentName:find("window")
		local isTriggerZone = name:find("zone") or name:find("trigger") or name:find("spawn") or name:find("area") or name:find("hitbox") or name:find("node") or name:find("part") or name:find("box")

		table.insert(removedItems, { type = "Part", instance = obj, originalTransparency = obj.Transparency })
		if isTriggerZone or obj.Transparency > 0.5 then
			obj.Transparency = 1
		elseif isBarrier then
			obj.Transparency = math.clamp(obj.Transparency, 0, 0.3)
		else
			obj.Transparency = 1
		end
	end
end

local function toggleTextureRemoval(forceState)
	textureRemovalOn = forceState ~= nil and forceState or not textureRemovalOn

	if textureRemovalOn then
		removedItems = {}
		for _, obj in ipairs(workspace:GetDescendants()) do processPartForFPS(obj) end
	else
		for _, data in ipairs(removedItems) do
			if data.type == "Texture" then
				local parent = data.parent
				if parent and parent:IsA("BasePart") then
					local newObj = data.className == "Decal" and Instance.new("Decal") or data.className == "Texture" and Instance.new("Texture") or nil
					if newObj then
						if data.face and newObj:IsA("Decal") then newObj.Face = data.face end
						newObj.Texture = data.texture
						newObj.Parent = parent
					end
				end
			elseif data.type == "Part" then
				if data.instance and data.instance.Parent then data.instance.Transparency = data.originalTransparency end
			elseif data.type == "Effect" then
				if data.instance and data.instance:IsA("ParticleEmitter") then data.instance.Enabled = data.wasEnabled end
			end
		end
		removedItems = {}
	end

	if fpsButtonRef then
		fpsButtonRef.BackgroundColor3 = textureRemovalOn and Color3.fromRGB(0, 180, 100) or Color3.fromRGB(50, 50, 55)
	end
end

