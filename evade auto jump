-- SHOOTING STAR ENGINE
-- =========================================================

local starColors = {
    Color3.fromRGB(255, 255, 255),
    Color3.fromRGB(120, 220, 255),
    Color3.fromRGB(255, 150, 220),
    Color3.fromRGB(255, 230, 100),
    Color3.fromRGB(160, 100, 255),
    Color3.fromRGB(100, 255, 180)
}

local function spawnShootingStar()
    if not shootingStarGui then return end

    local starTrail = Instance.new("Frame")
    local randomColor = starColors[math.random(1, #starColors)]
    
    starTrail.Size = UDim2.new(0, math.random(60, 120), 0, 2)
    starTrail.Rotation = math.random(25, 45)
    starTrail.BackgroundColor3 = randomColor
    starTrail.BorderSizePixel = 0
    starTrail.BackgroundTransparency = 0.1

    local startX = math.random(1, 80) / 100
    local startY = math.random(1, 40) / 100
    starTrail.Position = UDim2.new(startX, 0, startY, 0)
    starTrail.Parent = shootingStarGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = starTrail

    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, randomColor),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
    })
    gradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.7, 0.2),
        NumberSequenceKeypoint.new(1, 0)
    })
    gradient.Parent = starTrail

    local distanceX = math.random(20, 40) / 100
    local distanceY = math.random(15, 30) / 100
    local duration = math.random(4, 9) / 10

    local moveTween = tweenService:Create(starTrail, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Position = UDim2.new(startX + distanceX, 0, startY + distanceY, 0),
        BackgroundTransparency = 1
    })

    moveTween:Play()
    moveTween.Completed:Connect(function()
        starTrail:Destroy()
    end)
end

local function startShootingStars()
    if shootingStarGui then shootingStarGui:Destroy() end

    shootingStarGui = Instance.new("ScreenGui")
    shootingStarGui.Name = "DarkNightShootingStars"
    shootingStarGui.ResetOnSpawn = false
    shootingStarGui.DisplayOrder = 1
    shootingStarGui.Parent = playerGui

    if shootingStarTask then task.cancel(shootingStarTask) end

    shootingStarTask = task.spawn(function()
        while darkModeOn do
            task.wait(math.random(15, 35) / 10)
            if darkModeOn then
                spawnShootingStar()
            end
        end
    end)
end

local function stopShootingStars()
    if shootingStarTask then
        task.cancel(shootingStarTask)
        shootingStarTask = nil
    end
    if shootingStarGui then
        shootingStarGui:Destroy()
        shootingStarGui = nil
    end
end

-- DARK MODE (PITCH BLACK SKY + BRIGHT GROUND)
local function applyNightTime()
    if isUpdatingLighting then return end
    isUpdatingLighting = true

    lighting.Brightness = 2.0
    lighting.Ambient = Color3.fromRGB(150, 150, 150)
    lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 140)
    lighting.ClockTime = 0
    lighting.ExposureCompensation = 0
    lighting.GlobalShadows = false 

    lighting.FogStart = 0
    lighting.FogEnd = 8000
    lighting.FogColor = Color3.fromRGB(0, 0, 0)

    for _, child in ipairs(lighting:GetChildren()) do
        if (child:IsA("Atmosphere") or child:IsA("Sky") or child:IsA("PostEffect")) and child.Name ~= "CustomStarrySky" and child.Name ~= "CustomBlackAtmosphere" then
            table.insert(hiddenMapLightingObjects, { object = child, parent = child.Parent })
            child.Parent = nil
        end
    end

    if not customAtmosphere or customAtmosphere.Parent ~= lighting then
        if customAtmosphere then customAtmosphere:Destroy() end
        customAtmosphere = Instance.new("Atmosphere")
        customAtmosphere.Name = "CustomBlackAtmosphere"
        customAtmosphere.Density = 0.5
        customAtmosphere.Offset = 0
        customAtmosphere.Color = Color3.fromRGB(0, 0, 0)
        customAtmosphere.Decay = Color3.fromRGB(0, 0, 0)
        customAtmosphere.Glare = 0
        customAtmosphere.Haze = 0
        customAtmosphere.Parent = lighting
    end

    if not starrySky or starrySky.Parent ~= lighting then
        if starrySky then starrySky:Destroy() end
        starrySky = Instance.new("Sky")
        starrySky.Name = "CustomStarrySky"
        
        starrySky.SkyboxBk = "rbxassetid://60348217"
        starrySky.SkyboxDn = "rbxassetid://60348217"
        starrySky.SkyboxFt = "rbxassetid://60348217"
        starrySky.SkyboxLf = "rbxassetid://60348217"
        starrySky.SkyboxRt = "rbxassetid://60348217"
        starrySky.SkyboxUp = "rbxassetid://60348217"
        
        starrySky.StarCount = 5000
        starrySky.CelestialBodiesShown = false
        starrySky.Parent = lighting
    end

    scanAndGlowNextbots()

    isUpdatingLighting = false
end

local function restoreLighting()
    isUpdatingLighting = true

    if starrySky then
        starrySky:Destroy()
        starrySky = nil
    end
    if customAtmosphere then
        customAtmosphere:Destroy()
        customAtmosphere = nil
    end

    for _, obj in ipairs(lighting:GetChildren()) do
        if obj:IsA("Sky") or obj:IsA("Atmosphere") then
            obj:Destroy()
        end
    end

    for _, data in ipairs(hiddenMapLightingObjects) do
        if data.object then
            data.object.Parent = data.parent or lighting
            if data.object:IsA("PostEffect") then
                data.object.Enabled = true
            end
        end
    end
    hiddenMapLightingObjects = {}

    lighting.Brightness = (defaultMapLighting.Brightness and defaultMapLighting.Brightness > 0) and defaultMapLighting.Brightness or 2.5
    lighting.Ambient = defaultMapLighting.Ambient or Color3.fromRGB(130, 130, 130)
    lighting.OutdoorAmbient = defaultMapLighting.OutdoorAmbient or Color3.fromRGB(130, 130, 130)
    lighting.ClockTime = defaultMapLighting.ClockTime or 14.5
    lighting.FogEnd = 100000
    lighting.FogStart = 0
    lighting.FogColor = Color3.fromRGB(190, 190, 190)
    lighting.ExposureCompensation = 0
    lighting.GlobalShadows = true

    removeAllNextbotGlows()

    isUpdatingLighting = false
end

local function toggleDarkMode(forceState)
    if forceState ~= nil then
        darkModeOn = forceState
    else
        darkModeOn = not darkModeOn
    end

    if darkModeOn then
        applyNightTime()
        startShootingStars()
    else
        stopShootingStars()
        restoreLighting()
    end

    if darkButtonRef then
        darkButtonRef.BackgroundColor3 = darkModeOn and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    end
end

-- LISTENERS FOR MAP LOADS AND NEXTBOT SPAWNS
table.insert(connections, lighting.ChildAdded:Connect(function(child)
    if darkModeOn and not isUpdatingLighting then
        task.defer(applyNightTime)
    end
end))

table.insert(connections, lighting.Changed:Connect(function(property)
    if darkModeOn and not isUpdatingLighting then
        if property == "ClockTime" or property == "Brightness" or property == "Ambient" or property == "OutdoorAmbient" then
            task.defer(applyNightTime)
        end
    end
end))

table.insert(connections, workspace.DescendantAdded:Connect(function(descendant)
    if textureRemovalOn then
        task.defer(function()
            processPartForFPS(descendant)
        end)
    end
    if darkModeOn then
        if descendant:IsA("Model") and not game.Players:GetPlayerFromCharacter(descendant) then
            task.defer(function()
                local isNextbot = descendant.Name:lower():find("nextbot") or descendant.Name:lower():find("bot")
                if isNextbot then
                    applyNextbotGlow(descendant)
                end
            end)
        end
    end
end))

-- Rejoin function
local function rejoinSameServer()
