-- 1. LOADING SCREEN WITH FLOPPA IMAGE & SMOOTH PROGRESS BAR
-- =========================================================

local function createLoadingScreen()
    local gui = Instance.new("ScreenGui")
    gui.Name = "LoadingScreen"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 999999
    gui.Parent = playerGui

    -- Background
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    bg.BackgroundTransparency = 0.15
    bg.Parent = gui

    -- Big Floppa Image Container
    local image = Instance.new("ImageLabel")
    image.Size = UDim2.new(0.35, 0, 0.35, 0)
    image.Position = UDim2.new(0.5, 0, 0.38, 0)
    image.AnchorPoint = Vector2.new(0.5, 0.5)
    image.BackgroundTransparency = 1
    image.Image = "rbxthumb://type=Asset&id=9913176040&w=420&h=420"
    image.ScaleType = Enum.ScaleType.Fit
    image.Parent = bg

    local aspect = Instance.new("UIAspectRatioConstraint")
    aspect.AspectRatio = 1
    aspect.Parent = image

    -- Progress Bar Background
    local barBackground = Instance.new("Frame")
    barBackground.Size = UDim2.new(0, 320, 0, 22)
    barBackground.Position = UDim2.new(0.5, 0, 0.68, 0)
    barBackground.AnchorPoint = Vector2.new(0.5, 0.5)
    barBackground.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    barBackground.BorderSizePixel = 0
    barBackground.Parent = bg

    local barCorner = Instance.new("UICorner")
    barCorner.CornerRadius = UDim.new(0, 8)
    barCorner.Parent = barBackground

    -- Progress Bar Fill Inner
    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new(0, 0, 1, 0)
    barFill.BackgroundColor3 = Color3.fromRGB(0, 220, 120)
    barFill.BorderSizePixel = 0
    barFill.Parent = barBackground

    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(0, 8)
    fillCorner.Parent = barFill

    -- Progress Percentage Text
    local progressText = Instance.new("TextLabel")
    progressText.Size = UDim2.new(0, 200, 0, 30)
    progressText.Position = UDim2.new(0.5, 0, 0.76, 0)
    progressText.AnchorPoint = Vector2.new(0.5, 0.5)
    progressText.BackgroundTransparency = 1
    progressText.Text = "Loading Floppa... 0%"
    progressText.TextColor3 = Color3.fromRGB(255, 255, 255)
    progressText.TextScaled = true
    progressText.Font = Enum.Font.GothamBold
    progressText.Parent = bg

    -- Smooth Progress Animation
    local tweenInfo = TweenInfo.new(LOADING_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local fillTween = tweenService:Create(barFill, tweenInfo, { Size = UDim2.new(1, 0, 1, 0) })
    
    fillTween:Play()

    local startTime = tick()
    local connection
    connection = runService.RenderStepped:Connect(function()
        local elapsed = tick() - startTime
        local progress = math.clamp(elapsed / LOADING_DURATION, 0, 1)
        progressText.Text = "Loading Floppa... " .. math.floor(progress * 100) .. "%"

        if progress >= 1 then
            connection:Disconnect()
        end
    end)

    fillTween.Completed:Wait()
    task.wait(0.2)

    -- Fade Out Transition
    local fadeTweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    local bgFade = tweenService:Create(bg, fadeTweenInfo, { BackgroundTransparency = 1 })
    local textFade = tweenService:Create(progressText, fadeTweenInfo, { TextTransparency = 1 })
    local imageFade = tweenService:Create(image, fadeTweenInfo, { ImageTransparency = 1 })
    local barFade = tweenService:Create(barBackground, fadeTweenInfo, { BackgroundTransparency = 1 })
    local fillFade = tweenService:Create(barFill, fadeTweenInfo, { BackgroundTransparency = 1 })

    bgFade:Play()
    textFade:Play()
    imageFade:Play()
    barFade:Play()
    fillFade:Play()

    bgFade.Completed:Wait()
    gui:Destroy()
end

createLoadingScreen()

