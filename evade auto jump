				tweenService:Create(child, openTI, { ImageTransparency = 0 }):Play()
			elseif child:IsA("UIStroke") and child ~= windowStroke then
				tweenService:Create(child, openTI, { Transparency = 0.4 }):Play()
			end
		end
		tweenService:Create(shadow, openTI, { ImageTransparency = 0.5 }):Play()
	end)
end

