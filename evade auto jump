end

local function restoreLighting()
	isUpdatingLighting = true
	if starrySky then starrySky:Destroy(); starrySky = nil end
	if customAtmosphere then customAtmosphere:Destroy(); customAtmosphere = nil end
	for _, obj in ipairs(lighting:GetChildren()) do
		if obj:IsA("Sky") or obj:IsA("Atmosphere") then obj:Destroy() end
	end
	for _, data in ipairs(hiddenMapLightingObjects) do
		if data.object then
			data.object.Parent = data.parent or lighting
			if data.object:IsA("PostEffect") then data.object.Enabled = true end
		end
	end
	hiddenMapLightingObjects = {}
	lighting.Brightness = (defaultMapLighting.Brightness and defaultMapLighting.Brightness > 0) and defaultMapLighting.Brightness or 2.5
	lighting.Ambient = defaultMapLighting.Ambient or Color3.fromRGB(130, 130, 130)
	lighting.OutdoorAmbient = defaultMapLighting.OutdoorAmbient or Color3.fromRGB(130, 130, 130)
	lighting.ClockTime = defaultMapLighting.ClockTime or 14.5
	lighting.FogEnd = 100000; lighting.FogStart = 0; lighting.FogColor = Color3.fromRGB(190, 190, 190)
	lighting.ExposureCompensation = 0; lighting.GlobalShadows = true
	removeAllNextbotGlows()
	isUpdatingLighting = false
end

local function toggleDarkMode(forceState)
	darkModeOn = forceState ~= nil and forceState or not darkModeOn
	if darkModeOn then applyNightTime(); startShootingStars() else stopShootingStars(); restoreLighting() end
	if darkButtonRef then
		darkButtonRef.BackgroundColor3 = darkModeOn and Color3.fromRGB(0, 180, 100) or Color3.fromRGB(50, 50, 55)
	end
end

