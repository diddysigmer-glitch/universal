startRoundTimerTracking()

-- =========================================================
-- 4. CHARACTER INITIALIZATION & LIGHT EVENTS
-- =========================================================

local isSpaceHeld = false
local spacePressTime = 0
local character = nil
local rootPart = nil
local humanoid = nil

local function isFullyGrounded()
	if not humanoid or not rootPart then return false end
	if humanoid.FloorMaterial == Enum.Material.Air then return false end
	if rootPart.AssemblyLinearVelocity.Y < -0.5 then return false end
	return true
end

local function performJump()
	if not isFullyGrounded() then return end
	humanoid.Jump = true
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
end

local function setupCharacter(char)
	character = char
	rootPart = char:WaitForChild("HumanoidRootPart", 5)
	humanoid = char:WaitForChild("Humanoid", 5)

	local charConnection
	charConnection = char.DescendantAdded:Connect(function(descendant)
		if lanternToggleOn and descendant:IsA("Light") and descendant.Name ~= "PersistentLanternLight" then
			task.defer(function()
				if descendant.Parent then
					captureAndPersistLanternLight(char)
				end
			end)
		end
	end)
	table.insert(connections, charConnection)

	if lanternToggleOn then
		task.delay(0.5, function() 
			captureAndPersistLanternLight(char) 
		end)
	end
end

if player.Character then setupCharacter(player.Character) end
table.insert(connections, player.CharacterAdded:Connect(setupCharacter))

-- =========================================================
-- 5. AUTO-JUMP & INPUT LISTENERS
-- =========================================================

table.insert(connections, userInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	
	if input.KeyCode == Enum.KeyCode.Space then
		isSpaceHeld = true
		spacePressTime = tick()
	end
end))

table.insert(connections, userInputService.InputEnded:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.Space then
		isSpaceHeld = false
		local duration = tick() - spacePressTime
		if duration < TAP_THRESHOLD then
			performJump()
		end
	end
end))

-- Stop jumping if typing in chat box
table.insert(connections, userInputService.TextBoxFocused:Connect(function()
	isSpaceHeld = false
end))

table.insert(connections, runService.PostSimulation:Connect(function()
	if not isSpaceHeld then return end
	if tick() - spacePressTime < HOLD_DELAY then return end
	if isFullyGrounded() then
		performJump()
	end
end))
