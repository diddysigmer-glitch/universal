local function rejoinSameServer()
	if rejoinButtonRef then rejoinButtonRef.BackgroundColor3 = Color3.fromRGB(0, 220, 120) end
	task.wait(0.3)
	if #game.Players:GetPlayers() <= 1 then teleportService:Teleport(game.PlaceId, player)
