local function applyNightTime()
	if isUpdatingLighting then return end
	isUpdatingLighting = true
	lighting.Brightness = 2.0
	lighting.Ambient = Color3.fromRGB(150, 150, 150)
	lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 140)
	lighting.ClockTime = 0
	lighting.ExposureCompensation = 0
	lighting.GlobalShadows = false
	lighting.FogStart = 0
	lighting.FogEnd = 8000
	lighting.FogColor = Color3.fromRGB(0, 0, 0)

	for _, child in ipairs(lighting:GetChildren()) do
		if (child:IsA("Atmosphere") or child:IsA("Sky") or child:IsA("PostEffect")) and child.Name ~= "CustomStarrySky" and child.Name ~= "CustomBlackAtmosphere" then
			table.insert(hiddenMapLightingObjects, { object = child, parent = child.Parent })
			child.Parent = nil
		end
	end

	if not customAtmosphere or customAtmosphere.Parent ~= lighting then
		if customAtmosphere then customAtmosphere:Destroy() end
		customAtmosphere = Instance.new("Atmosphere")
		customAtmosphere.Name = "CustomBlackAtmosphere"
		customAtmosphere.Density = 0.5; customAtmosphere.Offset = 0
		customAtmosphere.Color = Color3.fromRGB(0, 0, 0); customAtmosphere.Decay = Color3.fromRGB(0, 0, 0)
		customAtmosphere.Glare = 0; customAtmosphere.Haze = 0
		customAtmosphere.Parent = lighting
	end

	if not starrySky or starrySky.Parent ~= lighting then
		if starrySky then starrySky:Destroy() end
