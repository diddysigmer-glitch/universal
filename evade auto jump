end

local function destroyScript()
	if textureRemovalOn then toggleTextureRemoval(false) end
	if darkModeOn then toggleDarkMode(false) end
	if lanternToggleOn then toggleLanternMode(false) end
	for _, conn in ipairs(connections) do if conn then conn:Disconnect() end end
	connections = {}
	if mainGuiRef then mainGuiRef:Destroy() end
end

