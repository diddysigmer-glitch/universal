        rejoinButtonRef.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    end
    if #game.Players:GetPlayers() <= 1 then
        teleportService:Teleport(game.PlaceId, player)
    else
        teleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
    end
end

-- UNLOAD SCRIPT
local function destroyScript()
    if textureRemovalOn then toggleTextureRemoval(false) end
    if darkModeOn then toggleDarkMode(false) end
    if lanternToggleOn then toggleLanternMode(false) end

    for _, conn in ipairs(connections) do
        if conn then conn:Disconnect() end
    end
    connections = {}

    if mainGuiRef then
        mainGuiRef:Destroy()
    end
end

