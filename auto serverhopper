-- Auto-start delayed handler
task.spawn(function()
    if isRunning then
        for i = REEXEC_DELAY, 1, -1 do
            if _G.ServerHopKill or not isRunning then break end
            updateStatus("Auto-start check in " .. i .. "s...")
            task.wait(1)
        end
        if not _G.ServerHopKill and isRunning then
            updateStatus("Running")
            checkPopulation()
        end
    end
end)

-- Main monitoring loop
task.spawn(function()
    while not _G.ServerHopKill do
        task.wait(CHECK_INTERVAL)
        updatePlayerCount()

        if isRunning and not isHopping then
            checkPopulation()

            -- v12: one-time post-join AFK check per server instance
            if settings.afkWatch
               and not afkChecked
               and (os.time() - JOIN_TIME) >= AFK_GRACE_PERIOD
            then
                afkChecked = true
                task.spawn(runAFKCheck)
            end
        end
    end
    _G.ServerHopActive = false
end)
