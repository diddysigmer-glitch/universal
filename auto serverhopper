local SAVE_FILE = "ServerHopSettings.json"
local settings = {
    threshold    = 4,
    afkThreshold = 8,
    mode         = "Highest",
    running      = false,
    afkWatch     = true,
}

local function saveSettings()
    pcall(function() writefile(SAVE_FILE, HttpService:JSONEncode(settings)) end)
end

local function loadSettings()
    local success, data = pcall(function()
        if isfile(SAVE_FILE) then return HttpService:JSONDecode(readfile(SAVE_FILE)) end
    end)
    if success and data then
        settings.threshold    = tonumber(data.threshold)    or 4
        settings.afkThreshold = tonumber(data.afkThreshold) or 8
        settings.mode         = data.mode      or "Highest"
        settings.running      = (data.running == true)
        settings.afkWatch     = (data.afkWatch ~= false)
    end
end
