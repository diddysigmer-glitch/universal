-- ============================================
-- HTTP API FETCH
-- ============================================
local function fetchApiData(url)
    if httpRequest then
        local directUrl = url:gsub("roproxy.com", "roblox.com")
        local success, res = pcall(function() return httpRequest({Url = directUrl, Method = "GET"}) end)
        if success and res and res.Body then return res.Body end
    end
    local s, r = pcall(function() return game:HttpGet(url) end)
    return s and r or nil
end

-- ============================================
-- AFK DETECTION
-- ============================================
local function countAFKPlayersInternal()
    local counted = {}
    local afkCount = 0

    local function mark(name)
        if name and not counted[name] and Players:FindFirstChild(name) then
            counted[name] = true
            afkCount += 1
        end
    end

    -- Pattern 1: Players.AFK folder
    local topAFK = Players:FindFirstChild("AFK")
    if topAFK then
        for _, child in ipairs(topAFK:GetChildren()) do
            mark(child.Name)
        end
    end

    -- Pattern 2: Workspace.AFK / ReplicatedStorage.AFK
    for _, container in ipairs({workspace, ReplicatedStorage}) do
        local f = container:FindFirstChild("AFK")
        if f then
            for _, child in ipairs(f:GetChildren()) do
                mark(child.Name)
            end
        end
    end

    -- Pattern 3-5: per-player checks
    for _, plr in ipairs(Players:GetPlayers()) do
        local isAFK = plr:GetAttribute("AFK")
            or plr:GetAttribute("IsAFK")
            or plr:GetAttribute("afk")
            or plr:GetAttribute("Afk")
        if isAFK == true then mark(plr.Name) end

        if plr:FindFirstChild("AFK") or plr:FindFirstChild("IsAFK") then
            mark(plr.Name)
        end

        local team = plr.Team
        if team and string.find(string.lower(team.Name), "afk", 1, true) then
            mark(plr.Name)
        end
    end

    return afkCount
end

countAFKPlayers = countAFKPlayersInternal

-- ============================================
-- UNIVERSAL SEARCH ENGINE
-- ============================================
local function getBestServer(isForce)
    local cursor    = ""
    local sortOrder = (settings.mode == "Highest") and "Desc" or "Asc"
    local scanned   = 0
    local bestLowest = nil

    for page = 1, MAX_PAGES do
        updateStatus(("Scanning page %d (%d servers)..."):format(page, scanned))

        local url = ("https://games.roproxy.com/v1/games/%d/servers/Public?sortOrder=%s&limit=100&cursor=%s"):format(
            game.PlaceId, sortOrder, cursor)
        local raw = fetchApiData(url)
        if not raw then
            updateStatus("API error. Retrying...")
            break
        end

        local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
        if not ok or not data or not data.data then break end

        for _, srv in ipairs(data.data) do
            scanned += 1
            if srv.id ~= game.JobId and not blacklist[srv.id] then
                local play = tonumber(srv.playing) or 0
                local maxP = tonumber(srv.maxPlayers) or 0
                local free = maxP - play

                if free >= 1 then
                    if isForce then
                        if play > 0 then
                            return {id = srv.id, playing = play, freeSlots = free, maxPlayers = maxP}
                        end

                    elseif settings.mode == "Highest" then
                        if play >= MIN_REAL_PLAYERS_SCAN
                           and free >= MIN_FREE_SLOTS
                           and play > settings.threshold
                        then
                            return {id = srv.id, playing = play, freeSlots = free, maxPlayers = maxP}
                        end

                    elseif settings.mode == "Lowest" then
                        if play < settings.threshold then
                            if not bestLowest or play < bestLowest.playing then
                                bestLowest = {id = srv.id, playing = play, freeSlots = free, maxPlayers = maxP}
                                if play <= 1 then
                                    return bestLowest, scanned
                                end
                            end
                        end
                    end
                end
            end
        end

        local nextCursor = data.nextPageCursor
        if not nextCursor or nextCursor == "" then break end
        cursor = HttpService:UrlEncode(nextCursor)
    end

    if settings.mode == "Lowest" then
        return bestLowest, scanned
    end
    return nil, scanned
end

-- ============================================
-- TELEPORT ENGINE
-- ============================================
performHop = function(reason)
    if isHopping and (os.time() - lastHopTime) > STUCK_TIMEOUT then
        isHopping = false
    end

    if isHopping or (not isRunning and reason ~= "FORCE") then return end
    isHopping = true
    lastHopTime = os.time()

    local server, scanned = getBestServer(reason == "FORCE")

    if server then
        updateStatus(("Joining %d/%d (%d free)..."):format(server.playing, server.maxPlayers, server.freeSlots))
        lastAttemptedServer = server.id
        task.wait(0.3)

        local teleportOk = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
        end)

        if not teleportOk then
            blacklist[server.id] = true
            updateStatus("Teleport call failed. Retrying...")
            isHopping = false
            task.spawn(function()
                task.wait(RETRY_DELAY)
                if isRunning then performHop("Teleport Call Failed Retry") end
            end)
        end
    else
        local msg = (scanned and scanned > 0)
            and ("No match in %d scanned. Retrying..."):format(scanned)
            or  "No match. Retrying..."
        updateStatus(msg)
        task.spawn(function()
            task.wait(RETRY_DELAY)
            isHopping = false
            if isRunning then performHop("Retry Search") end
        end)
    end
end

-- ============================================
-- HOP CONDITION CHECK (Population + AFK)
-- ============================================
checkPopulation = function()
    if _G.ServerHopKill or isHopping or not isRunning then return end

    local count = #Players:GetPlayers()

    -- --- AFK THRESHOLD (independent trigger, gated by grace + min size) ---
    if settings.afkWatch
       and (os.time() - JOIN_TIME) >= AFK_SETTLE_GRACE
       and count >= 2
    then
        local ok, afkCount = pcall(countAFKPlayers)  -- v13.1: pcall wrapper
        if ok and type(afkCount) == "number" then
            lastAFKCount = afkCount
            if afkCount >= settings.afkThreshold then
                updatePlayerCount()
                performHop(("AFK Threshold (%d ≥ %d)"):format(afkCount, settings.afkThreshold))
                return
            end
        end
    end

    updatePlayerCount()

    -- --- POPULATION THRESHOLD ---
    if settings.mode == "Highest" then
        if count <= settings.threshold then
            performHop("Low Pop Trigger (" .. count .. " ≤ " .. settings.threshold .. ")")
        end
    elseif settings.mode == "Lowest" then
        if count >= settings.threshold then
            performHop("High Pop Trigger (" .. count .. " ≥ " .. settings.threshold .. ")")
        end
    end
end

-- ============================================
-- ERROR HANDLERS (AUTO-RECOVERY)
-- ============================================
GuiService.ErrorMessageChanged:Connect(function()
    if not isRunning then return end
    if not lastAttemptedServer then return end

    local ok, msg = pcall(function() return GuiService:GetErrorMessage() end)
    msg = (ok and msg) or ""
    local lower = string.lower(msg)
    local isFullError = string.find(lower, "full", 1, true) ~= nil
                     or string.find(msg, "772", 1, true) ~= nil

    if not isFullError then return end

    blacklist[lastAttemptedServer] = true
    print("[ServerHop] Blacklisted full server: " .. lastAttemptedServer)
    updateStatus("Server Full! Hopping again...")
    isHopping = false
    task.wait(0.5)
    performHop("Error 772 Recovery")
end)

TeleportService.TeleportInitFailed:Connect(function(player, result, msg)
    if player ~= LocalPlayer then return end

    if lastAttemptedServer then blacklist[lastAttemptedServer] = true end

    if not isRunning then
        isHopping = false
        return
    end

    updateStatus("Failed. Retrying...")
    isHopping = false
    task.wait(1.5)
    performHop("Teleport Failure Retry")
end)

ForceButton.MouseButton1Click:Connect(function()
